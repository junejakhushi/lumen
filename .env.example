# Tiger Data (Timescale) connection string.
# Append &uselibpqcompat=true — without it pg rejects Tiger's certificate chain.
DATABASE_URL=
# DigitalOcean Spaces (private bucket) credentials
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=
SPACES_ENDPOINT=
# Random 32+ char string for signing session cookies
SESSION_SECRET=
# argon2 hash of the atelier dashboard passcode
ATELIER_PASSCODE_HASH=
# Display name for the atelier (white-label)
STUDIO_NAME=The Atelier
# Optional: email sending; logs to console if empty
RESEND_API_KEY=
# From address for outgoing email (must be verified with the provider)
EMAIL_FROM=
# Where booking notifications and the daily digest go
ATELIER_EMAIL=
# Public URL of the deployment, used for links inside emails
APP_BASE_URL=
# Shown in the confirmation email for an in-studio or video consultation
STUDIO_ADDRESS=
STUDIO_VIDEO_LINK=
# Client access code for local development, bypassing the access_codes table
DEV_ACCESS_CODE=
# Booking timezone
BOOKING_TZ=Asia/Kolkata
# AR calibration defaults
CAMERA_FOV_DEG=60
PALM_WIDTH_MM=80
